{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/field-run.json",
      "destination": "/api/field-run"
    },
    {
      "source": "/internet-field.json",
      "destination": "/api/internet-field"
    },
    {
      "source": "/te.json",
      "destination": "/api/te"
    }
  ],
  "functions": {
    "api/field-run.js": {
      "includeFiles": "closure-field.js"
    },
    "api/internet-field.js": {
      "includeFiles": "closure-field.js"
    },
    "api/te.js": {
      "includeFiles": "closure-field.js"
    }
  }
}
