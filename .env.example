CLOSURE_DB_PATH=runtime_data/closure_supernet.db
CLOSURE_INBOX_DIR=runtime_data/inbox
CLOSURE_BACKUP_DIR=runtime_data/backups
CLOSURE_BACKUP_KEEP=30
CLOSURE_AUTONOMY_ENABLED=true
CLOSURE_AUTONOMY_INTERVAL_SECONDS=5
CLOSURE_BOOTSTRAP_REPOSITORY=false
CLOSURE_BOOTSTRAP_ROOT=.
CLOSURE_MAX_CANDIDATES=8
CLOSURE_SEMANTIC_THRESHOLD=0.24
CLOSURE_AUTO_ADMIT_OPERATOR_PATH=false
CLOSURE_AUTO_ACTIVATE_RULES=false
CLOSURE_LLM_MODE=off
CLOSURE_LLM_BASE_URL=https://api.openai.com/v1
CLOSURE_LLM_MODEL=gpt-5-mini
# CLOSURE_LLM_API_KEY=

# Public living network and agentic reintegration
CLOSURE_PUBLIC_INTERFACE_ENABLED=true
CLOSURE_PUBLIC_DEVELOPMENT_MODE=true
CLOSURE_AGENTIC_REINTEGRATION_ENABLED=true
CLOSURE_PUBLIC_DEFAULT_VISIBILITY=PUBLIC

# NRRF768 finite runtime chart
CLOSURE_ITERATED_REOPENING_ENABLED=true
CLOSURE_REOPENING_PROCESSES_PER_CYCLE=16
CLOSURE_REOPENING_POWERSET_LIMIT=10

# Canonical directed TranslationEvent field; protocols remain transport charts.
CLOSURE_TRANSLATION_FIELD_ENABLED=true

# Open-form resource continuum; there is no finite kind registry or selected language.
CLOSURE_RESOURCE_PROTOCOL_ENABLED=true
CLOSURE_RESOURCE_REINTEGRATIONS_PER_CYCLE=32
CLOSURE_RESOURCE_STAGES_RETAINED=1000

# Context-indexed, witness-valued relative equality. These limits bound only
# automatic reverse-pair candidate discovery, never the source-level theory.
CLOSURE_RELATIVE_EQUALITY_ENABLED=true
CLOSURE_EQUALITY_TRANSLATION_SCAN_LIMIT=2000
CLOSURE_EQUALITY_PAIRS_PER_CYCLE=128

# Production envelope. Local development remains open unless changed.
CLOSURE_ENVIRONMENT=development
CLOSURE_SERVICE_ROLE=all
CLOSURE_AUTH_MODE=open
CLOSURE_AUTH_API_KEYS_JSON={}
# CLOSURE_SESSION_SECRET=
CLOSURE_SESSION_TTL_SECONDS=43200
# CLOSURE_AUTH_JWT_SECRET=
# CLOSURE_AUTH_JWKS_URL=
# CLOSURE_AUTH_ISSUER=
# CLOSURE_AUTH_AUDIENCE=
CLOSURE_AUTH_JWT_ALGORITHMS=RS256,HS256
CLOSURE_ALLOW_ANONYMOUS_READ=true
CLOSURE_ALLOW_ANONYMOUS_WRITE=false
CLOSURE_ALLOW_SELF_REGISTRATION=false
CLOSURE_PUBLIC_ONLY_MODE=true
CLOSURE_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CLOSURE_CORS_ORIGINS=
CLOSURE_RATE_LIMIT_READ_PER_MINUTE=300
CLOSURE_RATE_LIMIT_WRITE_PER_MINUTE=60
CLOSURE_MAX_REQUEST_BYTES=2097152

# Source-neutral digital integrations
CLOSURE_INTEGRATION_HTTP_TIMEOUT_SECONDS=30
CLOSURE_INTEGRATION_MAX_ITEMS=500
CLOSURE_INTEGRATION_USER_AGENT=closure-supernet/0.8
CLOSURE_INTEGRATION_ALLOW_PRIVATE_NETWORKS=false

# Connector secrets are referenced by environment-variable name in the
# integration registry. The secret values themselves are never stored.
# GITHUB_TOKEN=
# CLOSURE_NOTES_WEBHOOK_SECRET=
# CLOSURE_OUTBOUND_SECRET=
