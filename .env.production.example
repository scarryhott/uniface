CLOSURE_ENVIRONMENT=production
CLOSURE_SERVICE_ROLE=all
CLOSURE_DB_PATH=/data/closure_supernet.db
CLOSURE_INBOX_DIR=/data/inbox
CLOSURE_BACKUP_DIR=/data/backups
CLOSURE_BACKUP_KEEP=30
CLOSURE_AUTONOMY_ENABLED=true
CLOSURE_AUTONOMY_INTERVAL_SECONDS=5
CLOSURE_PUBLIC_INTERFACE_ENABLED=true
CLOSURE_PUBLIC_DEVELOPMENT_MODE=false
CLOSURE_AGENTIC_REINTEGRATION_ENABLED=true
CLOSURE_PUBLIC_DEFAULT_VISIBILITY=PUBLIC
CLOSURE_PUBLIC_ONLY_MODE=true

# Invite-key deployment. Replace every secret before starting.
CLOSURE_AUTH_MODE=api_key
CLOSURE_SESSION_SECRET=replace-with-at-least-32-random-bytes
CLOSURE_AUTH_API_KEYS_JSON={"replace-operator-key":{"subject":"operator","role":"operator","scopes":["*"]},"replace-member-key":{"subject":"member","role":"member"}}
CLOSURE_SESSION_TTL_SECONDS=43200
CLOSURE_ALLOW_ANONYMOUS_READ=true
CLOSURE_ALLOW_ANONYMOUS_WRITE=false
CLOSURE_ALLOW_SELF_REGISTRATION=false

# Set these to the actual production hostname/origin.
CLOSURE_TRUSTED_HOSTS=localhost,127.0.0.1
CLOSURE_CORS_ORIGINS=
CLOSURE_RATE_LIMIT_READ_PER_MINUTE=300
CLOSURE_RATE_LIMIT_WRITE_PER_MINUTE=60
CLOSURE_MAX_REQUEST_BYTES=2097152

CLOSURE_TRANSLATION_FIELD_ENABLED=true
CLOSURE_RESOURCE_PROTOCOL_ENABLED=true
CLOSURE_ITERATED_REOPENING_ENABLED=true
CLOSURE_RELATIVE_EQUALITY_ENABLED=true
CLOSURE_TRADING_ENABLED=true
CLOSURE_RENORMALIZATION_ENABLED=true
CLOSURE_CONSTRUCTIVE_FORMS_ENABLED=true
CLOSURE_TRANSLATIONAL_FRAMEWORKS_ENABLED=true
CLOSURE_EMBODIED_SUPERNET_ENABLED=true

# Simulation-only Black Mirror hardware closure loop.
CLOSURE_HARDWARE_CLOSURE_ENABLED=true
CLOSURE_HARDWARE_REINTEGRATIONS_PER_CYCLE=16
CLOSURE_HARDWARE_CONSTRAINT_TTL_SECONDS=3600
CLOSURE_HARDWARE_AUTO_SYNTHESIZE=false

CLOSURE_INTEGRATION_HTTP_TIMEOUT_SECONDS=30
CLOSURE_INTEGRATION_MAX_ITEMS=500
CLOSURE_INTEGRATION_ALLOW_PRIVATE_NETWORKS=false

CLOSURE_LLM_MODE=off
# OPENAI_API_KEY=
